# status.kiramyao.com — a Caddyfile fragment.
#
# This host is NOT the same as api.kiramyao.com (the comment service and the HRT
# Core). It is its own hostname with its own block, so it does not share the
# `/comments` / `/hrt` prefix arrangement those two use. Nothing here needs the
# prefix-stripping the API host does.
#
# Pick ONE of the two front-door blocks below and delete the other, matching how the
# other service on this box is set up.

# ---------------------------------------------------------------------------
# Option A (recommended): Cloudflare orange-cloud in front, Caddy on the origin.
#   - Hides the origin IP, gives WAF and edge rate limiting.
#   - Cloudflare terminates TLS; the origin uses a Cloudflare Origin Certificate so
#     SSL/TLS mode can stay "Full (strict)".
#   - Put the certificate at /etc/caddy/certs/origin.pem and the key beside it.
#
# NOTE: a `status` A record (or CNAME) must exist in Cloudflare DNS, proxied. Without
# it the certificate has nothing to be issued for and this block will not serve.
# ---------------------------------------------------------------------------
status.kiramyao.com {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	# The same client-IP integrity rule the API host uses. The status page does not
	# rate-limit, but keeping the convention means a spoofed CF-Connecting-IP can
	# never become meaningful here later without someone noticing.
	#
	# These ranges come from https://www.cloudflare.com/ips-v4 and change very
	# rarely. Refresh with: curl -s https://www.cloudflare.com/ips-v4
	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
		141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 \
		198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
	request_header @not_cloudflare -CF-Connecting-IP

	reverse_proxy 127.0.0.1:8789 {
		# Overwrite, do not append: Caddy's default keeps the client-supplied value,
		# which would let the first (spoofed) entry win.
		header_up X-Forwarded-For {http.request.remote.host}
	}
}

# ---------------------------------------------------------------------------
# Option B: no Cloudflare proxy. Caddy obtains a Let's Encrypt certificate itself,
# so set the DNS record to "DNS only" (grey cloud) and open 80/443.
# ---------------------------------------------------------------------------
