# Copy to .env and fill in. Never commit the real file.
#
# `data/` and `.env` are both in .gitignore. The boce key in .env is a paid
# credential — it bills per check — so treat it like any other secret.

# --- Runtime ---------------------------------------------------------------
# 8787 is the comment service and 8788 the HRT Core, both on this box. Do not
# reuse either.
PORT=8789
# Keep 127.0.0.1 when a reverse proxy sits in front; never expose this port.
HOST=127.0.0.1
# The path this service is mounted at. `/` because it has a hostname of its own
# (`status.kiramyao.com`) rather than sharing one by prefix, the way the comment
# service and the HRT Core share `api.kiramyao.com` under /comments and /hrt.
# Set it to a prefix such as `/status` only if you are putting this behind a host
# that already serves something at the root.
BASE_PATH=/
# SQLite file. The only writable path the systemd unit grants.
DATA_FILE=data/status.sqlite

# --- The one public identity ----------------------------------------------
# What the status page calls itself in its own header and incident copy.
SITE_NAME=KiraMyao
# Where the page lives, for canonical links and the Caddy block.
PUBLIC_ORIGIN=https://status.kiramyao.com

# --- Targets -----------------------------------------------------------------
# Every probe target is a plain URL, so adding one is a config change rather
# than a code change. These four are the always-on free probes.
#
#   comments_api   the comment service's own health route
#   hrt_api        the HRT Core's health route
#   hrt_web        the tracker web app
#   site_overseas  the marketing site, probed from this box (Singapore)
COMMENTS_HEALTH_URL=https://api.kiramyao.com/comments/health
HRT_HEALTH_URL=https://api.kiramyao.com/hrt/health
HRT_WEB_URL=https://hrt.kiramyao.com/
SITE_URL=https://kiramyao.com/

# Where the public aggregate for the data-guardian block comes from.
HRT_STATS_URL=https://api.kiramyao.com/hrt/stats
COMMENTS_STATS_URL=https://api.kiramyao.com/comments/stats
STORIES_CATALOG_URL=https://kiramyao.com/.well-known/api-catalog.json

# --- Probing cadence ---------------------------------------------------------
# How often the free probes run, per target.
PROBE_INTERVAL_MINUTES=30
# How many days of history the page shows.
HISTORY_DAYS=90

# --- boce (mainland-China reachability) -------------------------------------
# The only paid component. BOCE_ENABLED=false disables the CN column entirely
# and the page degrades to "CN sample unavailable" rather than showing a green
# it cannot justify.
#
# Cost: ~1 波点 per node per check. 28 nodes once daily is ~0.056 CNY/day.
# The ids behind `auto` are verified against the live API, because boce retires
# nodes and a dead id silently drops out of the round rather than failing loudly.
BOCE_ENABLED=false
BOCE_API_KEY=
# The endpoint and request shape are whatever the calibration call confirmed —
# see deploy/BOCE.md. Left unset, the adapter uses the documented default.
BOCE_API_URL=
# The target boce probes. Site reachability is the question, so this is the
# marketing site, not the API.
BOCE_TARGET_URL=https://kiramyao.com/
# Comma-separated node specs, or `auto` to let the adapter pick 28 across the
# three carriers.
BOCE_NODES=auto
# Daily. The handoff settled on once-daily, not hourly — 24x the cost for a
# signal that does not change that fast.
BOCE_INTERVAL_HOURS=24

# --- What counts as a fault --------------------------------------------------------
# The share of a CN round that may fail before the row stops reading as healthy.
# Unset means the built-in default of 0.2.
#
# This is a real judgement, not a knob nobody should touch. The CN sample is ~28 nodes
# on three carriers, from a country whose routes to a Cloudflare-fronted site vary by
# province and by hour, so a node or two failing is the ordinary state of the network
# rather than a fault in this service. Observed across the first rounds: 25–28 of 28
# reachable, i.e. a 0–11% failure rate that never once meant the site was broken.
#
# Set it to 0 to report every unreachable node, which will make the row amber most
# days. Raising it hides real regional problems, so change it against evidence.
CN_TOLERATED_FAILURE_RATIO=0.2

# --- Cloudflare edge analytics ------------------------------------------------------
# Optional, and both or neither. Set together to show visitor counts on the page; leave
# both unset and the two tiles render "—".
#
# Why Cloudflare rather than a script in the page: kiramyao.com is served by Cloudflare
# Pages, so there is no origin and no origin log — the edge is the only place that sees
# the request. Reading it here also keeps the privacy policy's two claims true (no
# analytics scripts, no requests to third-party hosts). The tracker app made the same
# move on 2026-09-18, dropping its Umami tag.
#
# The token needs Zone.Analytics:Read for this zone. Create it under My Profile →
# API Tokens using the "Read analytics" template.
CF_ANALYTICS_TOKEN=
# The zone id, not the account id. Zone → Overview → API, on the right.
CF_ZONE_TAG=
