# Copy to .env and fill in. Never commit the real file.
#
# `data/` and `.env` are both in .gitignore. The boce key in .env is a paid
# credential — it bills per check — so treat it like any other secret.

# --- Runtime ---------------------------------------------------------------
# 8787 is the comment service and 8788 the HRT Core, both on this box. Do not
# reuse either.
PORT=8789
# Keep 127.0.0.1 when a reverse proxy sits in front; never expose this port.
HOST=127.0.0.1
# The namespace this service owns on the shared origin.
BASE_PATH=/status
# SQLite file. The only writable path the systemd unit grants.
DATA_FILE=data/status.sqlite

# --- The one public identity ----------------------------------------------
# What the status page calls itself in its own header and incident copy.
SITE_NAME=Kira Status
# Where the page lives, for canonical links and the Caddy block.
PUBLIC_ORIGIN=https://status.kiramyao.com

# --- Targets -----------------------------------------------------------------
# Every probe target is a plain URL, so adding one is a config change rather
# than a code change. These four are the always-on free probes.
#
#   comments_api   the comment service's own health route
#   hrt_api        the HRT Core's health route
#   hrt_web        the tracker web app
#   site_overseas  the marketing site, probed from this box (Singapore)
COMMENTS_HEALTH_URL=https://api.kiramyao.com/comments/health
HRT_HEALTH_URL=https://api.kiramyao.com/hrt/health
HRT_WEB_URL=https://hrt.kiramyao.com/
SITE_URL=https://kiramyao.com/

# Where the public aggregate for the data-guardian block comes from.
HRT_STATS_URL=https://api.kiramyao.com/hrt/stats
COMMENTS_STATS_URL=https://api.kiramyao.com/comments/stats
STORIES_CATALOG_URL=https://kiramyao.com/.well-known/api-catalog.json

# --- Probing cadence ---------------------------------------------------------
# How often the free probes run, per target.
PROBE_INTERVAL_MINUTES=30
# How many days of history the page shows.
HISTORY_DAYS=90

# --- boce (mainland-China reachability) -------------------------------------
# The only paid component. BOCE_ENABLED=false disables the CN column entirely
# and the page degrades to "CN sample unavailable" rather than showing a green
# it cannot justify.
#
# Cost: ~1 波点 per node per check. 30 nodes once daily is ~0.06 CNY/day.
BOCE_ENABLED=false
BOCE_API_KEY=
# The endpoint and request shape are whatever the calibration call confirmed —
# see deploy/BOCE.md. Left unset, the adapter uses the documented default.
BOCE_API_URL=
# The target boce probes. Site reachability is the question, so this is the
# marketing site, not the API.
BOCE_TARGET_URL=https://kiramyao.com/
# Comma-separated node specs, or `auto` to let the adapter pick ~30 across the
# three carriers.
BOCE_NODES=auto
# Daily. The handoff settled on once-daily, not hourly — 24x the cost for a
# signal that does not change that fast.
BOCE_INTERVAL_HOURS=24
